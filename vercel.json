{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": { "includeFiles": "backend/{app,data/seed,i18n}/**", "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index" },
    { "source": "/status/:path*", "destination": "/api/index" },
    { "source": "/dids/:path*", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" }
  ]
}
