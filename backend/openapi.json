      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "By State"
     },
     "open_cases": {
      "type": "integer",
      "title": "Open Cases"
     },
     "upload_compliance": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Upload Compliance"
     },
     "ledger_ok": {
      "type": "boolean",
      "title": "Ledger Ok"
     }
