     "rejected_rows_total": {
      "type": "integer",
      "title": "Rejected Rows Total",
      "description": "rows rejected with errors across all batches (not counted toward intake until resubmitted)"
     },
     "apaar_coverage": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Apaar Coverage"
     }
