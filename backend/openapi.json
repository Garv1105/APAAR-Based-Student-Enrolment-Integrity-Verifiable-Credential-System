    "type": "object",
    "required": [
     "totals",
     "excess_ranking",
     "category_mix",
     "by_state",
     "open_cases",
     "upload_compliance",
     "ledger_ok"
    ],
    "title": "AicteDashboard"
   },
   "BatchOut": {
    "properties": {
     "batch_id": {
      "type": "integer",
      "title": "Batch Id"
     },
     "institution_id": {
      "type": "string",
      "title": "Institution Id"
     },
     "status": {
      "type": "string",
      "enum": [
       "processing",
       "completed",
       "failed"
      ],
      "title": "Status"
     },
     "channel": {
      "type": "string",
      "enum": [
       "portal_csv",
       "api_json"
      ],
      "title": "Channel"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
     },
     "counts": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Counts",
      "description": "rows, accepted, rejected, warnings, flags"
     },
     "replayed": {
      "type": "boolean",
      "title": "Replayed",
      "description": "true when returned for a repeated Idempotency-Key",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "batch_id",
     "institution_id",
     "status",
     "channel",
     "created_at",
     "counts"
    ],
    "title": "BatchOut"
   },
   "EnrolmentOut": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "programme_id": {
      "type": "string",
      "title": "Programme Id"
     },
     "academic_year": {
      "type": "string",
      "title": "Academic Year"
     },
     "institution_student_id": {
      "type": "string",
      "title": "Institution Student Id"
     },
     "apaar_masked": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Apaar Masked"
     },
     "provisional_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Provisional Id"
     },
     "apaar_status": {
      "type": "string",
      "title": "Apaar Status"
     },
     "status": {
      "type": "string",
      "title": "Status"
     },
     "seat_category_code": {
      "type": "string",
      "title": "Seat Category Code"
     },
     "flags": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Flags",
      "description": "codes raised by this change, e.g. E501"
     }
    },
    "type": "object",
    "required": [
     "id",
     "programme_id",
     "academic_year",
     "institution_student_id",
     "apaar_masked",
     "provisional_id",
     "apaar_status",
     "status",
     "seat_category_code",
     "flags"
    ],
    "title": "EnrolmentOut"
   },
   "EnrolmentPatch": {
    "properties": {
     "status": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "active",
         "withdrawn",
         "migrated",
         "completed"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Status"
     },
     "ended_on": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "Ended On"
     },
     "year_of_study": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Year Of Study"
     },
     "reason": {
      "type": "string",
      "minLength": 3,
      "title": "Reason"
     }
    },
    "type": "object",
    "required": [
     "reason"
    ],
    "title": "EnrolmentPatch"
   },
