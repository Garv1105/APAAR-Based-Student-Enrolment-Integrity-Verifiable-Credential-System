    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "InstitutionDashboard": {
    "properties": {
     "institution_id": {
      "type": "string",
      "title": "Institution Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "programmes": {
      "items": {
       "$ref": "#/components/schemas/ProgrammeSeats"
      },
      "type": "array",
      "title": "Programmes"
     },
     "batches": {
      "items": {
       "$ref": "#/components/schemas/BatchOut"
      },
      "type": "array",
      "title": "Batches"
     },
     "open_notices": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Open Notices",
